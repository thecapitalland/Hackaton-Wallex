# Copy to .env and fill in. NEVER commit .env
WALLEX_API_KEY=
MODE=paper            # backtest | paper | live
LIVE=0                # must be 1 (plus --i-understand-live-risk flag) for real orders
# Optional overrides of config.yaml
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=240
RISK_PER_TRADE=0.025
MAX_DAILY_DRAWDOWN=0.15
MAX_OPEN_POSITIONS=2
START_EQUITY_USDT=1000
# LLM regime agent (OpenAI-compatible). Leave empty to use rule-based fallback.
BOXAPI_BASE_URL=
BOXAPI_API_KEY=
LLM_MODEL=gpt-4o-mini
